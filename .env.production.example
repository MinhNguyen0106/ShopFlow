# ==============================================================================
# ShopFlow - Production Environment Variables Template (TASK-26.3)
# File: .env.production.example
# ==============================================================================
#
# Hướng dẫn:
# 1. Sao chép tệp này thành `.env.production`:
#    cp .env.production.example .env.production
# 2. Thay thế toàn bộ các giá trị bí mật bằng mật khẩu/khóa thực tế.
# 3. Tuyệt đối không commit tệp `.env.production` lên GitHub.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Cấu hình Ứng dụng & Miền Production
# ------------------------------------------------------------------------------
NODE_ENV=production
PORT=5000
API_PREFIX=/api/v1
APP_URL=https://shopflow.vn
CORS_ORIGIN=https://shopflow.vn

# ------------------------------------------------------------------------------
# 2. Cơ sở dữ liệu PostgreSQL 15
# ------------------------------------------------------------------------------
POSTGRES_DB=shopflow_production
POSTGRES_USER=shopflow_admin
POSTGRES_PASSWORD=YOUR_STRONG_POSTGRES_PASSWORD_HERE_AT_LEAST_32_CHARS
POSTGRES_PORT=5432

# ------------------------------------------------------------------------------
# 3. Redis 7 (BullMQ & Cache Layer)
# ------------------------------------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=YOUR_STRONG_REDIS_PASSWORD_HERE_AT_LEAST_32_CHARS

# ------------------------------------------------------------------------------
# 4. Bảo mật JWT & Mã hóa AES-256-GCM
# ------------------------------------------------------------------------------
# Sinh bằng lệnh: openssl rand -base64 32
JWT_ACCESS_SECRET=GENERATE_RANDOM_BASE64_32_BYTES_FOR_ACCESS_SECRET
JWT_REFRESH_SECRET=GENERATE_RANDOM_BASE64_32_BYTES_FOR_REFRESH_SECRET
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d
TOKEN_ENCRYPTION_KEY=GENERATE_RANDOM_32_BYTES_STRING_FOR_AES_ENCRYPTION

# ------------------------------------------------------------------------------
# 5. Meta Graph API (Facebook OAuth & Webhook Ingestion)
# ------------------------------------------------------------------------------
FACEBOOK_APP_ID=YOUR_FACEBOOK_APP_ID
FACEBOOK_APP_SECRET=YOUR_FACEBOOK_APP_SECRET
FACEBOOK_VERIFY_TOKEN=YOUR_CUSTOM_SECURE_WEBHOOK_VERIFY_TOKEN

# ------------------------------------------------------------------------------
# 6. Cloudinary Storage (Media Streaming & Uploads)
# ------------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=YOUR_CLOUDINARY_CLOUD_NAME
CLOUDINARY_API_KEY=YOUR_CLOUDINARY_API_KEY
CLOUDINARY_API_SECRET=YOUR_CLOUDINARY_API_SECRET

# ------------------------------------------------------------------------------
# 7. Google Gemini AI (NLP Entity Extraction & Content Generation)
# ------------------------------------------------------------------------------
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
GEMINI_MODEL=gemini-2.5-flash
