# ==============================================================================
# ShopFlow - Agent Ignore Specification (.agentignore)
# Prevents AI Agents from indexing, scanning, or leaking sensitive/bulky data.
# ==============================================================================

# Dependencies & Package Managers
node_modules/
jspm_packages/
.pnp
.pnp.js

# Environment & Sensitive Credentials
.env
.env.*
!.env.example
*.pem
*.key
*.cert
*.p12
*.pfx
secrets/
credentials/
id_rsa*
*.keystore

# Build Outputs & Compilation Artifacts
dist/
build/
out/
.next/
.nuxt/
*.tsbuildinfo

# Python Runtime & Virtual Environments
venv/
.venv/
env/
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Testing & Code Coverage
coverage/
.nyc_output/
*.lcov
test-results/
playwright-report/

# Logs & Runtime Diagnostics
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Operating System & IDE Specifics
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
*.swp
*.swo

# Temporary Files & Scratch Data
tmp/
temp/
scratch/
*.tmp
*.bak

# Large Media & Binary Assets
*.mp4
*.avi
*.mov
*.mkv
*.zip
*.tar
*.gz
*.7z
*.rar
*.iso
*.dmg
